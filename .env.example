# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=<Numéro DB>
REDIS_PASSWORD=<Mot de passe>

# PostgreSQL
POSTGRESQL_HOST=postgres
POSTGRESQL_PORT=5432
POSTGRESQL_DB=<Nom DB>
POSTGRESQL_USER=<Nom utilisateur>
POSTGRESQL_PASSWORD=<Mot de passe>

# PgAdmin configuration
PGADMIN_EMAIL=<Nom utilisateur>
PGADMIN_PASSWORD=<Mot de passe>

# API
API_URL=http://api
API_PORT=8000
API_ENABLE_CPROFILE=True
API_PREDICT_ROUTE=predict
API_LOGS_INFERENCE_ROUTE=logs/inference-data
API_LOGS_PROFILING_ROUTE=logs/profiling